# Copiar a .env y completar. .env está en .gitignore: no lo suban.

# Obligatorio para MusicBrainz (User-Agent con contacto).
CONTACT_EMAIL=

# Opcional, pero es la mejor fuente de tags de mood y de oyentes.
LASTFM_API_KEY=

# Opcional.
LISTENBRAINZ_TOKEN=

# Opcional: solo para ver si las canciones se pueden exportar.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Solo para `python -m vibematch_poc generate`.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
