# Copiar a .env y completar. .env está en .gitignore: no lo suban.

# Obligatorio para MusicBrainz (User-Agent con contacto).
CONTACT_EMAIL=

# Opcional, pero es la mejor fuente de tags de mood y de oyentes.
LASTFM_API_KEY=

# Opcional.
LISTENBRAINZ_TOKEN=

# Spotify. Para `export` alcanza con el Client ID (OAuth con PKCE).
# El secret solo lo usa `run` para la búsqueda sin iniciar sesión (opcional).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Solo para `python -m vibematch_poc generate`.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
